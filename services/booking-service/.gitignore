# ==============================================================================
# ParkEase Monorepo - Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/

# Environment files and secrets (Never commit secrets)
.env
.env.*
*.env
!.env.example
!*.env.example
!.env.*.example

# Build and distribution artifacts
dist/
build/
out/

# Test coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local database files and backups
*.mdf
*.ldf
*.ndf
*.bak
*.sqlite
*.sqlite3
*.db

# Temporary and cache files
tmp/
temp/
*.tmp
*.swp
*.swo
*~
.cache/

# IDE and editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# System-generated files
.system_generated/
