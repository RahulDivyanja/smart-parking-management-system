# ==============================================================================
# ParkEase Notification Service - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=3005
NODE_ENV=development

# Database Configuration (Microsoft SQL Server)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=ParkEase_NotificationDB
DB_USER=ParkEaseAppUser
DB_PASSWORD=YourStrongPasswordHere
DB_TRUST_SERVER_CERTIFICATE=true
DB_SYNCHRONIZE=false
DB_LOGGING=false

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=parkease.events
RABBITMQ_QUEUE=parkease.notifications.queue
RABBITMQ_RETRY_EXCHANGE=parkease.events.retry
RABBITMQ_RETRY_QUEUE=parkease.notifications.retry.queue
RABBITMQ_DLX=parkease.events.dlx
RABBITMQ_DLQ=parkease.notifications.dlq
RABBITMQ_RETRY_LIMIT=3
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_PREFETCH=10

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_DELIVERY_ENABLED=false

# External Microservice URLs (Provisional User Service Contract)
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_USER_ENDPOINT=/api/v1/users/:userId
USER_SERVICE_TIMEOUT=5000

# Reminder Sweeper Configuration
REMINDER_SWEEPER_INTERVAL_MS=60000
