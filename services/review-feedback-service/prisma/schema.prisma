generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  ACTIVE
  HIDDEN
  PENDING
}

model Review {
  id            String       @id @default(uuid())
  userId        String
  facilityId    String
  reservationId String       @unique
  rating        Int
  comment       String?
  status        ReviewStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([facilityId])
  @@index([userId])
  @@map("reviews")
}
